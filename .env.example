# Aegis Environment Variables

# Network & Ports
GATEWAY_PORT=8080
NODE_A_PORT=8081
NODE_B_PORT=8082
NODE_C_PORT=8083
NODE_D_PORT=8084
API_GATEWAY_PORT=8000
GRPC_ML_PORT=50051

# Infrastructure
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegissecretpassword
POSTGRES_DB=aegis_db

# Aegis Control
TOPOLOGY_PATH=configs/topology.yaml
ENABLE_SYNTHETIC_LOAD=false
LOG_LEVEL=INFO

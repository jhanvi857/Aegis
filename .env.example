# Aegis Environment Variables

# Network & Ports
GATEWAY_PORT=8080
NODE_A_PORT=8081
NODE_B_PORT=8082
NODE_C_PORT=8083
NODE_D_PORT=8084
API_GATEWAY_PORT=8000
AEGIS_OTLP_HTTP_PORT=4318
AEGIS_CONFIG_URL=
AEGIS_CONFIG_FILE=
GRPC_ML_PORT=50051
AEGIS_DETECTION_CONFIG_FILE=./configs/detection_rules.example.yaml

# Infrastructure
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=aegis_db

# Aegis Control & Security
AEGIS_TOPOLOGY_FILE=./configs/topology.generic.yaml
ENABLE_SYNTHETIC_LOAD=false
LOG_LEVEL=INFO
AEGIS_AUTH_SECRET=
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@enterprise.io
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=YourSecureAdminPassword#2026!
DATABASE_URL=postgres://aegis:your_secure_postgres_password_here@localhost:5432/aegis_db?sslmode=disable
